# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/doanvien?schema=public"

# DIRECT_URL: kết nối TRỰC TIẾP (không qua pooler) dùng để tạo bảng. Bỏ trống nếu DATABASE_URL đã là kết nối trực tiếp.
# DIRECT_URL=""

# Chuỗi bí mật >= 32 ký tự dùng ký session và QR token (openssl rand -base64 48)
AUTH_SECRET=""

# URL public của ứng dụng (dùng để tạo link trong QR)
APP_URL="http://localhost:3000"

# Cloudinary (chỉ dùng phía server)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Triển khai (Vercel): chỉ có tác dụng khi database còn TRỐNG
# SEED_DEMO=true               nạp dữ liệu demo giống local (bỏ qua nếu muốn DB sạch)
# ADMIN_USERNAME=admin         tài khoản admin đầu tiên (khi không dùng SEED_DEMO)
# ADMIN_INITIAL_PASSWORD=      để trống -> sinh ngẫu nhiên và in ra log build 1 lần

# Web Push (thông báo đẩy) – tạo khóa: npx web-push generate-vapid-keys
# Bảo vệ cron nhắc lịch (Vercel tự gửi Bearer này). Đặt chuỗi ngẫu nhiên dài.
CRON_SECRET=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:email-quan-tri@truong.edu.vn"

# (Tùy chọn) Chuỗi kết nối QUA POOLER dùng khi chạy web trên Vercel -> tránh lỗi "too many connections".
# Nếu đặt, ứng dụng dùng chuỗi này thay DATABASE_URL lúc chạy; DATABASE_URL (trực tiếp) vẫn dùng để tạo bảng.
# DATABASE_POOLED_URL=""

# Trợ lý AI soạn bài (Google Gemini)
GEMINI_API_KEY=

# Thời gian thực cho Kênh chat (WSS qua Pusher Channels). Bỏ trống thì kênh chat tự dùng cách hỏi lại mỗi 2,5 giây.
# Tạo ứng dụng tại https://dashboard.pusher.com/channels (gói miễn phí), chọn cluster gần nhất (ví dụ ap1 - Singapore).
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
